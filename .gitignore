# TalentFlow AI - Cypher Matrix .gitignore

# Secrets
.env
.env.*
!.env.example
!.env.sample

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
coverage/
.next/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
tmp/
temp/
uploads/*
!uploads/.gitkeep
temp_uploads/
server/uploads/*
!server/uploads/.gitkeep

# Candidate personal documents (synthetic evaluation fixtures are whitelisted)
*.pdf
*.doc
*.docx
*.docm
!samples/test-resumes/*.pdf
!submission/*.pdf

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Runtime
*.pid
*.seed
*.local
qa-audit/
