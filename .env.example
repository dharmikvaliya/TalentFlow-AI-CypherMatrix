PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/talentflow_cyphermatrix?retryWrites=true&w=majority
MONGODB_DB_NAME=talentflow_cyphermatrix
CLIENT_ORIGIN=http://localhost:5173

# LLM Provider Configuration: 'mock' | 'openai' | 'openrouter' | 'groq' | 'nvidia' | 'ollama'
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=

# Safe demo default: defaults to true so deployed demo never spends money without explicit toggle
LLM_MOCK=true
LLM_ALLOW_MOCK_FALLBACK=false
TALENTFLOW_DEMO_MODE=false

# Demo quota limits (maximum workflow analyses per rolling 24-hour period, 0 = unlimited)
MAX_RUNS_PER_DAY=50
MAX_RUNS_PER_HOUR_PER_IP=10

# 1. OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 2. OpenRouter Configuration (Free model router)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=TalentFlow AI

# 3. Groq Configuration (Ultra-fast inference; verify account model access)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 4. NVIDIA NIM Configuration (Enter exact active model ID from build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 5. Ollama Configuration (Local, offline, zero-cost private inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
