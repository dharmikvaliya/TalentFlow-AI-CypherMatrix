PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/talentflow
CLIENT_ORIGIN=http://localhost:5173

# LLM Provider Configuration: 'mock' | 'openai' | 'openrouter' | 'groq' | 'nvidia' | 'together' | 'ollama'
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=

# Safe demo default: defaults to true so deployed demo never spends money without explicit toggle
LLM_MOCK=true
LLM_ALLOW_MOCK_FALLBACK=false
TALENTFLOW_DEMO_MODE=false

# Demo quota limits (maximum workflow analyses per rolling 24-hour period)
MAX_RUNS_PER_DAY=3

# 1. OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 2. OpenRouter Configuration (Free-only router)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=TalentFlow AI

# 3. Groq Configuration (Ultra-fast inference; verify account model access)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# 4. NVIDIA NIM Configuration (Enter exact active model ID from build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 5. Together AI Configuration (OpenAI-compatible endpoint)
TOGETHER_API_KEY=
TOGETHER_MODEL=MiniMaxAI/MiniMax-M3.1-Flash

# 6. Ollama Configuration (Local, offline, zero-cost private inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
