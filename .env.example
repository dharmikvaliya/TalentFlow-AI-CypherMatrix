PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/talentflow
CLIENT_ORIGIN=http://localhost:5173

# LLM Provider Configuration: 'openai' | 'ollama' | 'mock'
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Safe demo default: defaults to true so deployed demo never spends money without explicit toggle
LLM_MOCK=true
LLM_ALLOW_MOCK_FALLBACK=false

# Demo quota limits (maximum workflow analyses per rolling 24-hour period)
MAX_RUNS_PER_DAY=3

# Ollama Configuration (Used when LLM_PROVIDER=ollama for local, quota-free testing)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
